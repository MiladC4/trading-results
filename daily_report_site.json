  "fair_control_note": "\u0647\u0631 \u0633\u0647 \u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc \u0627\u0648\u0644\u0627\u064b \u0628\u0627 \u06a9\u0646\u062a\u0631\u0644\u06cc \u062a\u0623\u06cc\u06cc\u062f \u0634\u062f\u0647 \u0628\u0648\u062f\u0646\u062f \u06a9\u0647 \u0627\u0632 \u062e\u0648\u062f\u0650 \u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc \u0622\u0633\u0627\u0646\u200c\u062a\u0631 \u0628\u0648\u062f. \u0633\u067e\u0633 \u062a\u062e\u0645\u06cc\u0646 (estimand) \u0627\u0635\u0644\u0627\u062d \u0634\u062f: \u0641\u0627\u0635\u0644\u0647 \u0628\u0627\u06cc\u062f \u0646\u0645\u0627\u062f-\u0648\u0632\u0646\u200c\u0634\u062f\u0647 \u0628\u0627\u0634\u062f\u060c \u0686\u0648\u0646 \u0628\u0648\u062a\u200c\u0627\u0633\u062a\u0631\u067e \u0628\u0644\u0648\u06a9\u0650 \u0646\u0645\u0627\u062f \u0647\u0645\u0627\u0646 \u0631\u0627 \u0628\u0631\u0622\u0648\u0631\u062f \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0639\u062f\u062f \u0645\u0639\u0627\u0645\u0644\u0647\u200c\u0648\u0632\u0646\u200c\u0634\u062f\u0647 \u0628\u0631\u0627\u06cc \u0647\u0631 edge \u0645\u062b\u0628\u062a \u06f1\u06f5 \u062a\u0627 \u06f5\u06f9\u066a \u0628\u0632\u0631\u06af\u200c\u062a\u0631 \u0628\u0648\u062f \u0648 \u062f\u0648 \u062d\u06a9\u0645 \u0631\u0627 \u0628\u0631\u0639\u06a9\u0633 \u06a9\u0631\u062f.",
  "edge_status_note": "\u2705 Grid-Close-Short \u0646\u062e\u0633\u062a\u06cc\u0646 \u0627\u0633\u062a\u0631\u0627\u062a\u0698\u06cc \u0627\u06cc\u0646 \u067e\u0631\u0648\u0698\u0647 \u0627\u0633\u062a \u06a9\u0647 \u0631\u0648\u06cc \u0627\u0628\u0632\u0627\u0631\u06cc \u06a9\u0647 \u062f\u0642\u06cc\u0642\u0627\u064b \u0647\u0645\u0627\u0646 \u0686\u06cc\u0632\u06cc \u0631\u0627 \u0645\u06cc\u200c\u0633\u0646\u062c\u062f \u06a9\u0647 \u06a9\u062a\u0627\u0628 \u0645\u0639\u0627\u0645\u0644\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f\u060c \u0622\u0633\u062a\u0627\u0646\u0647 \u0631\u0627 \u0631\u062f \u06a9\u0631\u062f: \u0641\u0627\u0635\u0644\u0647 \u200e+\u06f1.\u06f0\u06f0\u066a\u200e\u060c \u06a9\u0645\u06cc\u0646\u0647 \u200e+\u06f0.\u06f7\u06f6\u066a\u200e\u060c \u0628\u062f\u062a\u0631\u06cc\u0646 \u062d\u0627\u0644\u062a P=\u06f0.\u06f9\u06f9\u060c \u06f7\u06f2\u066a \u0646\u0645\u0627\u062f \u0645\u062b\u0628\u062a\u060c \u0648 \u062f\u0631 \u0647\u0631 \u062f\u0648 \u0646\u06cc\u0645\u0647\u0654 \u0632\u0645\u0627\u0646 \u0648 \u0647\u0631 \u06f5\u06f2 \u062d\u0630\u0641 \u062a\u06a9\u200c\u0646\u0645\u0627\u062f\u06cc \u0632\u0646\u062f\u0647 \u0645\u0627\u0646\u062f. \u0627\u0632 \u06f1\u06f9 \u06a9\u0627\u0646\u062f\u06cc\u062f\u0627 \u0641\u0642\u0637 \u0647\u0645\u06cc\u0646 \u06cc\u06a9\u06cc \u0628\u0647 \u0622\u0633\u062a\u0627\u0646\u0647 \u0631\u0633\u06cc\u062f. Volume-Profile: \u0641\u0627\u0635\u0644\u0647 \u200e+\u06f0.\u06f3\u06f0\u066a\u200e\u060c \u06a9\u0645\u06cc\u0646\u0647 \u200e+\u06f0.\u06f1\u06f3\u066a\u200e\u060c \u0628\u062f\u062a\u0631\u06cc\u0646 \u062d\u0627\u0644\u062a P=\u06f0.\u06f7\u06f3 \u2014 \u0632\u0646\u062f\u0647 \u0648\u0644\u06cc \u062a\u062b\u0628\u06cc\u062a\u200c\u0646\u0634\u062f\u0647. Momentum-Break \u062e\u0627\u0631\u062c \u0634\u062f: \u0641\u0627\u0635\u0644\u0647\u200c\u0627\u0634 \u0628\u0627 \u062a\u062e\u0645\u06cc\u0646 \u062f\u0631\u0633\u062a \u0631\u0648\u06cc \u0628\u0639\u0636\u06cc \u06a9\u0634